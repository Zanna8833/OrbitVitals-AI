# Copy this file to `.env` (git-ignored) and adjust the values.
# Never commit real secrets. Every variable is prefixed with ORBITVITALS_.

ORBITVITALS_ENVIRONMENT=development

# Extra origins allowed to call the API, as a JSON list (e.g. the deployed frontend URL).
ORBITVITALS_CORS_ALLOW_ORIGINS=[]

# Regex of allowed origins. The default accepts any localhost port, which is what the
# Flutter Web development server uses. Uncomment to override.
# ORBITVITALS_CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
