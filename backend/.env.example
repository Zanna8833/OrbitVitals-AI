# Copy this file to `.env` (git-ignored) and adjust the values.
# Never commit real secrets. Every variable is prefixed with ORBITVITALS_.

ORBITVITALS_ENVIRONMENT=development

# Extra origins allowed to call the API, as a JSON list (e.g. the deployed frontend URL).
ORBITVITALS_CORS_ALLOW_ORIGINS=[]

# Regex of allowed origins. The default accepts any localhost port, which is what the
# React or Flutter Web development servers use. Uncomment to override.
# ORBITVITALS_CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Optional Data Quality Engine configuration, as a JSON object. Defaults use no
# invented device ranges or sampling cadence. Each sensor range requires a source.
# ORBITVITALS_DATA_QUALITY={"expected_intervals":{"sleep_duration":"P1D","sleep_efficiency":"P1D"}}

# Sleep has no default screening policy. Supply a complete reviewed SleepConfig JSON
# object here, or sleep_config in each evaluation command. See the frontend guide.
# ORBITVITALS_SLEEP_CONFIG={...}
