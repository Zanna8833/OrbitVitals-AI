# mock (default): deterministic synthetic data, no backend needed
# http: the team's FastAPI backend (backend/). Start it on port 8000; npm run dev forwards /api to it.
VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api/v1
# http mode: which backend crew members appear as crew-a/b/c ("local=backend-id:Name,...").
# Default: the three crews created by `python -m app.demo_seed seed`.
# VITE_BACKEND_CREW=crew-a=sim-mission-v1-01:Vega,crew-b=sim-mission-v1-02:Noor,crew-c=sim-mission-v1-03:Chen
# http mode, optional: "now" and mission day 1. Default: latest / earliest stored measurement.
# VITE_AS_OF=2026-10-25T20:00:00Z
# VITE_MISSION_START=2026-09-28
# Seconds between automatic data reloads (default 10). 0 disables auto-refresh.
VITE_REFRESH_INTERVAL_S=10
