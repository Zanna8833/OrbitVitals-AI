# Data source. Default: the OrbitVitals server (backend/, /api/v1).
# "mock" = generated sample data for offline development and tests only (npm run dev:sample).
# VITE_DATA_SOURCE=mock
VITE_API_BASE_URL=/api/v1
# The team's assistant service (ai_agent/). npm run dev forwards /agent to port 8100.
VITE_AGENT_BASE_URL=/agent/v1
# Which backend crew members are Astronaut A/B/C ("local=backend-id:Name,...").
# VITE_BACKEND_CREW=crew-a=sim-mission-v1-01:Astronaut A,crew-b=sim-mission-v1-02:Astronaut B,crew-c=sim-mission-v1-03:Astronaut C
# Optional "now" and mission day 1. Default: latest / earliest stored measurement.
# VITE_AS_OF=2026-10-25T20:00:00Z
# VITE_MISSION_START=2026-09-28
# Seconds between automatic data reloads (default 10). 0 disables auto-refresh.
VITE_REFRESH_INTERVAL_S=10
