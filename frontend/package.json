{
  "name": "orbitvitals-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run cognition && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "cognition": "npm --prefix ../cognition-frontend ci && npm --prefix ../cognition-frontend run build -- --base ./ --outDir ../frontend/public/cognition --emptyOutDir && node -e \"require('fs').cpSync('../cognition-frontend/public/faces','public/faces',{recursive:true})\"",
    "build:app": "tsc -b && vite build",
    "dev:sample": "vite --mode sample",
    "predev": "node -e \"process.exit(require('fs').existsSync('public/faces/manifest.json') ? 0 : 1)\" || npm run cognition"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
