{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated by backend/scripts/export_nasa_evidence_schema.py; do not edit.",
  "$defs": {
    "DatasetId": {
      "enum": [
        "nasa-lsda-brsmact-utmb-campaign-1",
        "nasa-lsda-mr001g-utmb-campaign-3-tilt"
      ],
      "title": "DatasetId",
      "type": "string"
    },
    "EvidenceFailure": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "code": {
          "enum": [
            "manifest_unavailable",
            "manifest_rejected",
            "source_missing",
            "source_unreadable",
            "source_rejected",
            "processing_failed"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "code",
        "message"
      ],
      "title": "EvidenceFailure",
      "type": "object"
    },
    "EvidenceItem": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "dataset_id": {
                "const": "nasa-lsda-mr001g-utmb-campaign-3-tilt"
              }
            }
          },
          "then": {
            "properties": {
              "relevant_variables": {
                "items": {
                  "properties": {
                    "unit_verification": {
                      "const": "unresolved"
                    },
                    "canonical_unit": {
                      "type": "null"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_verification": {
                "properties": {
                  "state": {
                    "not": {
                      "enum": [
                        "verified",
                        "synthetic_fixture_verified"
                      ]
                    }
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "structural_findings": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "else": {
            "properties": {
              "structural_findings": {
                "items": {
                  "properties": {
                    "data_origin": {
                      "const": "verified_nasa_source_files"
                    }
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "source_verification": {
                "properties": {
                  "state": {
                    "const": "synthetic_fixture_verified"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "structural_findings": {
                "items": {
                  "properties": {
                    "data_origin": {
                      "const": "synthetic_test_fixture"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "dataset_id": {
          "$ref": "#/$defs/DatasetId"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "nasa_source_url": {
          "title": "Nasa Source Url",
          "type": "string"
        },
        "study_population": {
          "title": "Study Population",
          "type": "string"
        },
        "study_context": {
          "const": "terrestrial_bed_rest_analogue",
          "default": "terrestrial_bed_rest_analogue",
          "title": "Study Context",
          "type": "string"
        },
        "evidence_scope": {
          "const": "scientific_context_only",
          "default": "scientific_context_only",
          "title": "Evidence Scope",
          "type": "string"
        },
        "crew_telemetry": {
          "const": false,
          "default": false,
          "title": "Crew Telemetry",
          "type": "boolean"
        },
        "clinically_validated": {
          "const": false,
          "default": false,
          "title": "Clinically Validated",
          "type": "boolean"
        },
        "nasa_endorsement": {
          "const": false,
          "default": false,
          "title": "Nasa Endorsement",
          "type": "boolean"
        },
        "topic": {
          "$ref": "#/$defs/EvidenceTopic"
        },
        "relevant_variables": {
          "items": {
            "$ref": "#/$defs/EvidenceVariable"
          },
          "title": "Relevant Variables",
          "type": "array"
        },
        "context_findings": {
          "items": {
            "type": "string"
          },
          "title": "Context Findings",
          "type": "array"
        },
        "structural_findings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StructuralFinding"
          },
          "title": "Structural Findings",
          "type": "array"
        },
        "source_verification": {
          "$ref": "#/$defs/SourceVerification"
        },
        "provenance": {
          "$ref": "#/$defs/EvidenceProvenance"
        },
        "redistribution_status": {
          "const": "unconfirmed",
          "default": "unconfirmed",
          "title": "Redistribution Status",
          "type": "string"
        },
        "publication_policy": {
          "const": "authored_context_and_verified_structural_counts_only",
          "default": "authored_context_and_verified_structural_counts_only",
          "title": "Publication Policy",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "dataset_id",
        "title",
        "nasa_source_url",
        "study_population",
        "topic",
        "relevant_variables",
        "context_findings",
        "source_verification",
        "provenance",
        "limitations"
      ],
      "title": "EvidenceItem",
      "type": "object"
    },
    "EvidenceProvenance": {
      "additionalProperties": false,
      "properties": {
        "manifest_path": {
          "title": "Manifest Path",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "source_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Snapshot Sha256",
          "type": "string"
        },
        "reviewed_source_file_count": {
          "minimum": 1,
          "title": "Reviewed Source File Count",
          "type": "integer"
        },
        "nasa_metadata_url": {
          "title": "Nasa Metadata Url",
          "type": "string"
        },
        "experiment_doi": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Experiment Doi"
        },
        "documentation_path": {
          "title": "Documentation Path",
          "type": "string"
        },
        "pipeline": {
          "title": "Pipeline",
          "type": "string"
        }
      },
      "required": [
        "manifest_path",
        "manifest_sha256",
        "source_snapshot_sha256",
        "reviewed_source_file_count",
        "nasa_metadata_url",
        "experiment_doi",
        "documentation_path",
        "pipeline"
      ],
      "title": "EvidenceProvenance",
      "type": "object"
    },
    "EvidenceTopic": {
      "enum": [
        "sleep",
        "actigraphy",
        "heart_rate",
        "blood_pressure",
        "cardiovascular_adaptation",
        "data_quality"
      ],
      "title": "EvidenceTopic",
      "type": "string"
    },
    "EvidenceVariable": {
      "additionalProperties": false,
      "properties": {
        "source_column": {
          "title": "Source Column",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "source_representation": {
          "title": "Source Representation",
          "type": "string"
        },
        "unit_verification": {
          "enum": [
            "reviewed_source_dictionary",
            "unresolved"
          ],
          "title": "Unit Verification",
          "type": "string"
        },
        "canonical_unit": {
          "anyOf": [
            {
              "enum": [
                "min",
                "%"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canonical Unit"
        },
        "transformation": {
          "title": "Transformation",
          "type": "string"
        }
      },
      "required": [
        "source_column",
        "description",
        "source_representation",
        "unit_verification",
        "canonical_unit",
        "transformation"
      ],
      "title": "EvidenceVariable",
      "type": "object"
    },
    "SourceVerification": {
      "additionalProperties": false,
      "else": {
        "properties": {
          "checks": {
            "maxItems": 0
          },
          "pipeline_code_sha256": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "state": {
            "enum": [
              "verified",
              "synthetic_fixture_verified"
            ]
          }
        }
      },
      "properties": {
        "state": {
          "enum": [
            "not_configured",
            "verified",
            "synthetic_fixture_verified",
            "unavailable",
            "rejected"
          ],
          "title": "State",
          "type": "string"
        },
        "checks": {
          "default": [],
          "items": {
            "enum": [
              "SHA-256",
              "MD5",
              "byte_count",
              "catalog_linkage"
            ],
            "type": "string"
          },
          "title": "Checks",
          "type": "array"
        },
        "pipeline_code_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pipeline Code Sha256"
        }
      },
      "required": [
        "state"
      ],
      "then": {
        "properties": {
          "checks": {
            "maxItems": 4,
            "minItems": 4,
            "uniqueItems": true
          },
          "pipeline_code_sha256": {
            "type": "string"
          }
        },
        "required": [
          "checks",
          "pipeline_code_sha256"
        ]
      },
      "title": "SourceVerification",
      "type": "object"
    },
    "StructuralFinding": {
      "additionalProperties": false,
      "description": "Whole-export shape diagnostics; physiological statistics have no field here.",
      "properties": {
        "code": {
          "enum": [
            "source_records",
            "observed_metric_cells",
            "source_missing_metric_cells",
            "invalid_numeric_metric_cells",
            "empty_source_records",
            "records_with_missing_context"
          ],
          "title": "Code",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "count_unit": {
          "enum": [
            "records",
            "cells"
          ],
          "title": "Count Unit",
          "type": "string"
        },
        "scope": {
          "const": "complete_selected_export",
          "default": "complete_selected_export",
          "title": "Scope",
          "type": "string"
        },
        "included_source_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Included Source Columns",
          "type": "array"
        },
        "data_origin": {
          "enum": [
            "verified_nasa_source_files",
            "synthetic_test_fixture"
          ],
          "title": "Data Origin",
          "type": "string"
        },
        "computation": {
          "title": "Computation",
          "type": "string"
        }
      },
      "required": [
        "code",
        "value",
        "count_unit",
        "included_source_columns",
        "data_origin",
        "computation"
      ],
      "title": "StructuralFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "else": {
    "properties": {
      "contains_synthetic_findings": {
        "const": false
      }
    }
  },
  "if": {
    "properties": {
      "items": {
        "contains": {
          "properties": {
            "source_verification": {
              "properties": {
                "state": {
                  "const": "synthetic_fixture_verified"
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "topic": {
      "$ref": "#/$defs/EvidenceTopic"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "unavailable",
        "no_matching_evidence"
      ],
      "title": "Status",
      "type": "string"
    },
    "contains_synthetic_findings": {
      "title": "Contains Synthetic Findings",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/EvidenceItem"
      },
      "title": "Items",
      "type": "array"
    },
    "failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EvidenceFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "notice": {
      "const": "Scientific dataset context only. Never substitute for crew telemetry or clinical assessment. Synthetic-fixture findings are tests, not NASA observations.",
      "default": "Scientific dataset context only. Never substitute for crew telemetry or clinical assessment. Synthetic-fixture findings are tests, not NASA observations.",
      "title": "Notice",
      "type": "string"
    }
  },
  "required": [
    "topic",
    "status",
    "contains_synthetic_findings",
    "items"
  ],
  "then": {
    "properties": {
      "contains_synthetic_findings": {
        "const": true
      }
    }
  },
  "title": "EvidenceResponse",
  "type": "object"
}
