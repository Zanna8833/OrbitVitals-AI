# Settings of the AI agent proof of concept. Every variable is optional; the values
# below are the defaults. Export them in the shell that starts the service: the agent
# reads the process environment and does not load this file by itself.
# Never commit real secrets. The agent needs none.

# OrbitVitals backend, read with GET requests only.
ORBITVITALS_AGENT_BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1
ORBITVITALS_AGENT_BACKEND_TIMEOUT_SECONDS=10

# Local Ollama server and the model that drafts the wording.
ORBITVITALS_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
ORBITVITALS_AGENT_PRIMARY_MODEL=qwen3.5:4b
ORBITVITALS_AGENT_MODEL_TIMEOUT_SECONDS=240
ORBITVITALS_AGENT_MODEL_CONTEXT_TOKENS=8192
ORBITVITALS_AGENT_MODEL_MAX_OUTPUT_TOKENS=1400
ORBITVITALS_AGENT_MODEL_TEMPERATURE=0
ORBITVITALS_AGENT_MODEL_SEED=7
ORBITVITALS_AGENT_MODEL_PRESENCE_PENALTY=0
ORBITVITALS_AGENT_MODEL_THINK=false
ORBITVITALS_AGENT_MODEL_KEEP_ALIVE=10m
ORBITVITALS_AGENT_MAX_GENERATION_ATTEMPTS=2

# Optional second-opinion model, selected by the name it was registered with.
# "none" disables it. See orbit_agent/specialist.py.
ORBITVITALS_AGENT_SPECIALIST=none

# Number of NASA passages retrieved for each explanation.
ORBITVITALS_AGENT_EVIDENCE_TOP_K=3
