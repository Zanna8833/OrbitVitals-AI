# Settings of the AI agent proof of concept. Every variable is optional; the values
# below are the defaults. Export them in the shell that starts the service: the agent
# reads the process environment and does not load this file by itself.
# Never commit real secrets. The agent needs none.

# OrbitVitals backend, read with GET requests only.
ORBITVITALS_AGENT_BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1
ORBITVITALS_AGENT_BACKEND_TIMEOUT_SECONDS=10

# Local Ollama server and the model that drafts the wording.
ORBITVITALS_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
ORBITVITALS_AGENT_PRIMARY_MODEL=gemma3:4b
ORBITVITALS_AGENT_MODEL_TIMEOUT_SECONDS=240
ORBITVITALS_AGENT_MODEL_CONTEXT_TOKENS=8192
ORBITVITALS_AGENT_MODEL_MAX_OUTPUT_TOKENS=1400
ORBITVITALS_AGENT_MODEL_TEMPERATURE=0
ORBITVITALS_AGENT_MODEL_SEED=7
ORBITVITALS_AGENT_MODEL_PRESENCE_PENALTY=0
ORBITVITALS_AGENT_MODEL_THINK=false
ORBITVITALS_AGENT_MODEL_KEEP_ALIVE=10m
ORBITVITALS_AGENT_MAX_GENERATION_ATTEMPTS=2

# Draft length by answer profile (see orbit_agent/routing.py): stored values (brief),
# greetings and questions about the assistant (conversation), general questions answered
# from the evidence corpus (general). Full answers use MODEL_MAX_OUTPUT_TOKENS.
ORBITVITALS_AGENT_BRIEF_MAX_OUTPUT_TOKENS=500
ORBITVITALS_AGENT_CONVERSATION_MAX_OUTPUT_TOKENS=200
ORBITVITALS_AGENT_GENERAL_MAX_OUTPUT_TOKENS=800
# Earlier chat turns, sent by the client in `conversation`, given to the model as context.
ORBITVITALS_AGENT_CONVERSATION_MAX_TURNS=8
# Names of each simulated crew member. History turns and model sentences naming another
# crew member than the requested one are not used. Empty: only crew IDs are checked.
ORBITVITALS_AGENT_CREW_ALIASES=sim-mission-v1-01=Crew A|Astronaut A|Vega;sim-mission-v1-02=Crew B|Astronaut B|Noor;sim-mission-v1-03=Crew C|Astronaut C|Chen
# Reply in Italian when the operator writes in Italian; false: only when asked explicitly.
ORBITVITALS_AGENT_REPLY_LANGUAGE_DETECTION=true
# Load the primary model in the background when the HTTP service starts.
ORBITVITALS_AGENT_WARM_UP_ON_START=true

# Optional second-opinion model, selected by the name it was registered with.
# "none" disables it; "medgemma" uses orbit_agent/medgemma.py. See INTEGRATION.md.
ORBITVITALS_AGENT_SPECIALIST=none
ORBITVITALS_AGENT_SPECIALIST_MODEL=medgemma1.5:4b
ORBITVITALS_AGENT_SPECIALIST_TIMEOUT_SECONDS=90
ORBITVITALS_AGENT_SPECIALIST_CONTEXT_TOKENS=4096
ORBITVITALS_AGENT_SPECIALIST_MAX_OUTPUT_TOKENS=400
# 0: unload MedGemma after each review, so it never slows the primary model (see INTEGRATION.md).
ORBITVITALS_AGENT_SPECIALIST_KEEP_ALIVE=0
# -1: Ollama places the model (measured fastest); 0: CPU only.
ORBITVITALS_AGENT_SPECIALIST_GPU_LAYERS=-1
# Background evidence for the specialist from rag/knowledge_base, limited to the sections
# admitted by scripts/review_specialist_kb.py. Needs requirements-specialist.txt; without
# it the specialist reviews on the backend facts alone. See INTEGRATION.md.
ORBITVITALS_AGENT_SPECIALIST_KNOWLEDGE=true
ORBITVITALS_AGENT_SPECIALIST_KNOWLEDGE_TOP_K=2
ORBITVITALS_AGENT_SPECIALIST_KNOWLEDGE_MIN_SIMILARITY=0.70

# NASA Dataset Evidence Adapter of the backend (GET /nasa-evidence).
ORBITVITALS_AGENT_NASA_DATASET_EVIDENCE=true

# Number of NASA passages retrieved for each explanation.
ORBITVITALS_AGENT_EVIDENCE_TOP_K=3
