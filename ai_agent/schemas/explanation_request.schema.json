{
  "$defs": {
    "ConversationTurn": {
      "additionalProperties": false,
      "description": "One earlier message of the chat, as the dashboard showed it.",
      "properties": {
        "role": {
          "enum": [
            "operator",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "crew_member_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Crew member the message was about. Turns about another one are not used.",
          "title": "Crew Member Id"
        },
        "domain": {
          "anyOf": [
            {
              "enum": [
                "vital_signs",
                "sleep",
                "physical_activity",
                "nutrition"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "ConversationTurn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "crew_member_id": {
      "description": "Opaque crew ID.",
      "maxLength": 128,
      "minLength": 1,
      "title": "Crew Member Id",
      "type": "string"
    },
    "domain": {
      "anyOf": [
        {
          "enum": [
            "vital_signs",
            "sleep",
            "physical_activity",
            "nutrition"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Restrict the explanation to one health domain.",
      "title": "Domain"
    },
    "question": {
      "anyOf": [
        {
          "maxLength": 500,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional question from the operator.",
      "title": "Question"
    },
    "mode": {
      "default": "auto",
      "description": "`auto` uses the local model when it is available. `deterministic` never calls a model.",
      "enum": [
        "auto",
        "deterministic"
      ],
      "title": "Mode",
      "type": "string"
    },
    "conversation": {
      "description": "Earlier messages of this chat, oldest first, kept by the client. The agent keeps no history of its own; it uses the most recent turns to understand follow-up questions. They are never used as facts.",
      "items": {
        "$ref": "#/$defs/ConversationTurn"
      },
      "maxItems": 40,
      "title": "Conversation",
      "type": "array"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "en",
            "it"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Reply language. Omitted: English, or Italian when the operator writes in or asks for Italian.",
      "title": "Language"
    }
  },
  "required": [
    "crew_member_id"
  ],
  "title": "ExplanationRequest",
  "type": "object"
}
