{
  "$defs": {
    "BackendRequest": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "integer"
        },
        "item_count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Count"
        }
      },
      "required": [
        "method",
        "path",
        "status",
        "item_count"
      ],
      "title": "BackendRequest",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "A summary, written by the OrbitVitals team, of one paragraph of a published source.\n\nThe source is a public NASA web page or an open-access peer-reviewed article. The\nsummary is not the source's text and not a quotation. `publisher`, `document_title`,\n`section` and `url` identify the source; neither NASA nor the authors or publishers\nof the articles reviewed or endorsed the summary.",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "source_type": {
          "default": "nasa_web_page",
          "enum": [
            "nasa_web_page",
            "peer_reviewed_article"
          ],
          "title": "Source Type",
          "type": "string"
        },
        "publisher": {
          "description": "NASA for a NASA page; the journal for an article.",
          "title": "Publisher",
          "type": "string"
        },
        "document_title": {
          "title": "Document Title",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "url": {
          "description": "The NASA page, or the DOI link of the article.",
          "title": "Url",
          "type": "string"
        },
        "authors": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Article authors, abbreviated.",
          "title": "Authors"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Publication year of the article.",
          "title": "Year"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Licence of the article as listed by Europe PMC.",
          "title": "License"
        },
        "verification_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the summarised paragraph can be fetched to check its digest, when that is not `url`.",
          "title": "Verification Url"
        },
        "summary": {
          "description": "Summary written by the OrbitVitals team; not source text.",
          "title": "Summary",
          "type": "string"
        },
        "text_kind": {
          "const": "independent_summary",
          "default": "independent_summary",
          "title": "Text Kind",
          "type": "string"
        },
        "sha256": {
          "description": "SHA-256 digest of `summary`, as stored in the corpus.",
          "title": "Sha256",
          "type": "string"
        },
        "source_paragraph_sha256": {
          "description": "SHA-256 digest of the summarised paragraph on the source page (whitespace collapsed). The paragraph itself is not stored.",
          "title": "Source Paragraph Sha256",
          "type": "string"
        },
        "source_checked_on": {
          "description": "Date the source paragraph was last confirmed on its page.",
          "title": "Source Checked On",
          "type": "string"
        },
        "scope": {
          "const": "general_evidence",
          "default": "general_evidence",
          "title": "Scope",
          "type": "string"
        },
        "relevance_score": {
          "title": "Relevance Score",
          "type": "number"
        }
      },
      "required": [
        "evidence_id",
        "publisher",
        "document_title",
        "section",
        "url",
        "summary",
        "sha256",
        "source_paragraph_sha256",
        "source_checked_on",
        "relevance_score"
      ],
      "title": "Citation",
      "type": "object"
    },
    "DataAccess": {
      "additionalProperties": false,
      "properties": {
        "read_only": {
          "const": true,
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "requests": {
          "items": {
            "$ref": "#/$defs/BackendRequest"
          },
          "title": "Requests",
          "type": "array"
        }
      },
      "required": [
        "requests"
      ],
      "title": "DataAccess",
      "type": "object"
    },
    "DataProvenance": {
      "additionalProperties": false,
      "properties": {
        "crew_data_kind": {
          "enum": [
            "simulated",
            "mixed",
            "not_simulated",
            "no_measurements"
          ],
          "title": "Crew Data Kind",
          "type": "string"
        },
        "measurement_sources": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Measurement Sources",
          "type": "object"
        },
        "crew_data_notice": {
          "title": "Crew Data Notice",
          "type": "string"
        },
        "evidence_notice": {
          "title": "Evidence Notice",
          "type": "string"
        }
      },
      "required": [
        "crew_data_kind",
        "measurement_sources",
        "crew_data_notice",
        "evidence_notice"
      ],
      "title": "DataProvenance",
      "type": "object"
    },
    "DatasetEvidence": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "not_requested",
            "disabled",
            "ok",
            "partial",
            "unavailable",
            "no_matching_evidence",
            "endpoint_unavailable",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "topics": {
          "items": {
            "type": "string"
          },
          "title": "Topics",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/DatasetEvidenceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "failures": {
          "items": {
            "$ref": "#/$defs/DatasetEvidenceFailure"
          },
          "title": "Failures",
          "type": "array"
        },
        "notice": {
          "default": "NASA dataset evidence describes terrestrial bed-rest studies of volunteers. It is research context only: not crew telemetry, not a reference range and not a clinical assessment. Structural counts from the adapter are not shown.",
          "title": "Notice",
          "type": "string"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "title": "DatasetEvidence",
      "type": "object"
    },
    "DatasetEvidenceFailure": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "code",
        "message"
      ],
      "title": "DatasetEvidenceFailure",
      "type": "object"
    },
    "DatasetEvidenceItem": {
      "additionalProperties": false,
      "description": "Ground-analogue research context from the backend's NASA Dataset Evidence Adapter.",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "dataset_id": {
          "title": "Dataset Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "nasa_source_url": {
          "title": "Nasa Source Url",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        },
        "study_population": {
          "title": "Study Population",
          "type": "string"
        },
        "study_context": {
          "const": "terrestrial_bed_rest_analogue",
          "title": "Study Context",
          "type": "string"
        },
        "evidence_scope": {
          "const": "scientific_context_only",
          "title": "Evidence Scope",
          "type": "string"
        },
        "crew_telemetry": {
          "const": false,
          "title": "Crew Telemetry",
          "type": "boolean"
        },
        "clinically_validated": {
          "const": false,
          "title": "Clinically Validated",
          "type": "boolean"
        },
        "nasa_endorsement": {
          "const": false,
          "title": "Nasa Endorsement",
          "type": "boolean"
        },
        "redistribution_status": {
          "const": "unconfirmed",
          "title": "Redistribution Status",
          "type": "string"
        },
        "source_verification": {
          "description": "`not_configured` means reviewed context only; files were not re-checked.",
          "title": "Source Verification",
          "type": "string"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/DatasetVariable"
          },
          "title": "Variables",
          "type": "array"
        },
        "context": {
          "items": {
            "type": "string"
          },
          "title": "Context",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "evidence_id",
        "dataset_id",
        "title",
        "nasa_source_url",
        "topic",
        "study_population",
        "study_context",
        "evidence_scope",
        "crew_telemetry",
        "clinically_validated",
        "nasa_endorsement",
        "redistribution_status",
        "source_verification",
        "variables",
        "context",
        "limitations"
      ],
      "title": "DatasetEvidenceItem",
      "type": "object"
    },
    "DatasetVariable": {
      "additionalProperties": false,
      "properties": {
        "source_column": {
          "title": "Source Column",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "canonical_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the unit of the NASA export is unresolved. Never inferred.",
          "title": "Canonical Unit"
        },
        "unit_verification": {
          "enum": [
            "reviewed_source_dictionary",
            "unresolved"
          ],
          "title": "Unit Verification",
          "type": "string"
        }
      },
      "required": [
        "source_column",
        "description",
        "canonical_unit",
        "unit_verification"
      ],
      "title": "DatasetVariable",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "One piece of information read from the backend, stated without interpretation.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "provenance",
            "evaluation",
            "finding",
            "baseline",
            "measurement_series",
            "quality_overview",
            "measurement_quality_issue"
          ],
          "title": "Kind",
          "type": "string"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "metric": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "description": "Structured values behind the statement.",
          "title": "Data",
          "type": "object"
        },
        "source": {
          "$ref": "#/$defs/FactSource"
        },
        "interpretation_role": {
          "enum": [
            "screening_signal",
            "no_physiological_basis",
            "context",
            "data_quality"
          ],
          "title": "Interpretation Role",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "statement",
        "data",
        "source",
        "interpretation_role"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FactSource": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "const": "GET",
          "default": "GET",
          "title": "Method",
          "type": "string"
        },
        "path": {
          "description": "Backend path the fact was read from.",
          "title": "Path",
          "type": "string"
        },
        "resource_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Identifier of the resource.",
          "title": "Resource Id"
        }
      },
      "required": [
        "path"
      ],
      "title": "FactSource",
      "type": "object"
    },
    "GenerationInfo": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "generative",
            "deterministic_fallback"
          ],
          "title": "Mode",
          "type": "string"
        },
        "generative": {
          "title": "Generative",
          "type": "boolean"
        },
        "fallback_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fallback Reason"
        },
        "primary_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Model"
        },
        "question_kind": {
          "default": "none",
          "description": "How the question was classified for routing.",
          "enum": [
            "none",
            "greeting",
            "general",
            "factual",
            "interpretive",
            "clinical_advice"
          ],
          "title": "Question Kind",
          "type": "string"
        },
        "answer_profile": {
          "default": "full",
          "description": "Size of the model draft: conversation (a short reply), general (an evidence-led answer), brief (stored values) or full (an explanation).",
          "enum": [
            "conversation",
            "general",
            "brief",
            "full"
          ],
          "title": "Answer Profile",
          "type": "string"
        },
        "reply_language": {
          "default": "en",
          "description": "Language the model was asked to write in.",
          "enum": [
            "en",
            "it"
          ],
          "title": "Reply Language",
          "type": "string"
        },
        "context_turns": {
          "default": 0,
          "description": "Earlier conversation turns sent by the client and given to the model as context. 0 means the question was answered on its own.",
          "title": "Context Turns",
          "type": "integer"
        },
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "model_runs": {
          "items": {
            "$ref": "#/$defs/ModelRun"
          },
          "title": "Model Runs",
          "type": "array"
        },
        "specialist": {
          "$ref": "#/$defs/SpecialistInfo"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings Ms",
          "type": "object"
        }
      },
      "required": [
        "mode",
        "generative",
        "specialist"
      ],
      "title": "GenerationInfo",
      "type": "object"
    },
    "HumanReview": {
      "additionalProperties": false,
      "properties": {
        "recommended": {
          "title": "Recommended",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "recommended",
        "reasons",
        "fact_ids"
      ],
      "title": "HumanReview",
      "type": "object"
    },
    "Interpretation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "description": "`model`: drafted by the language model and verified.",
          "enum": [
            "model",
            "rule"
          ],
          "title": "Origin",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "kind": {
          "enum": [
            "screening_signal",
            "data_quality"
          ],
          "title": "Kind",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "moderate"
          ],
          "title": "Confidence",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "origin",
        "kind",
        "confidence"
      ],
      "title": "Interpretation",
      "type": "object"
    },
    "ModelRun": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "primary",
            "specialist"
          ],
          "title": "Role",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "number"
        },
        "load_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Ms"
        },
        "prompt_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "prompt_eval_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Eval Ms"
        },
        "output_eval_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Eval Ms"
        },
        "rejected_sentences": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Sentences of this draft dropped by the verifier.",
          "title": "Rejected Sentences"
        }
      },
      "required": [
        "role",
        "model",
        "attempt",
        "accepted",
        "duration_ms"
      ],
      "title": "ModelRun",
      "type": "object"
    },
    "RejectedStatement": {
      "additionalProperties": false,
      "properties": {
        "section": {
          "title": "Section",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "section",
        "text",
        "reasons"
      ],
      "title": "RejectedStatement",
      "type": "object"
    },
    "SpecialistEvidenceRef": {
      "additionalProperties": false,
      "description": "A reviewed knowledge-base section given to the specialist as background.",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "document_title": {
          "title": "Document Title",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "similarity": {
          "title": "Similarity",
          "type": "number"
        },
        "knowledge_base": {
          "const": "rag/knowledge_base",
          "default": "rag/knowledge_base",
          "title": "Knowledge Base",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "document_id",
        "document_title",
        "section",
        "sources",
        "similarity"
      ],
      "title": "SpecialistEvidenceRef",
      "type": "object"
    },
    "SpecialistFinding": {
      "additionalProperties": false,
      "properties": {
        "statement_id": {
          "title": "Statement Id",
          "type": "string"
        },
        "verdict": {
          "enum": [
            "supported",
            "overstated",
            "unsupported",
            "no_opinion"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "applied": {
          "description": "What the agent did with this verdict.",
          "title": "Applied",
          "type": "string"
        }
      },
      "required": [
        "statement_id",
        "verdict",
        "applied"
      ],
      "title": "SpecialistFinding",
      "type": "object"
    },
    "SpecialistInfo": {
      "additionalProperties": false,
      "properties": {
        "configured": {
          "title": "Configured",
          "type": "string"
        },
        "consulted": {
          "title": "Consulted",
          "type": "boolean"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "evidence_status": {
          "default": "not_used",
          "description": "Specialist background evidence: used, none_relevant, unavailable: <reason>, or not_used when the specialist was not consulted or has no retrieval.",
          "title": "Evidence Status",
          "type": "string"
        },
        "evidence": {
          "description": "Provenance of the background sections the specialist was given.",
          "items": {
            "$ref": "#/$defs/SpecialistEvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "decision": {
          "default": "not_configured",
          "description": "Routing outcome, as a code. `consulted` means a model was really called.",
          "enum": [
